# .host-software — the Where room recipe. One [software "<name>"] stanza per
# component. The trees are gitignored (materialised locally by
# `host-lifecycle software --materialize`); this recipe is the audit anchor.

# The software under development. It now ships a binary, so the stanza carries
# the recipe that re-derives it. The crate has no dependencies, which is why the
# offline build needs no vendored bundle.
[software "calx-telltale"]
	url       = https://github.com/slartibardfast/calx-telltale.git
	pin       = 867917d213ff1d711172e19488619face7dc1da3
	worktrees =
	toolchain = docker.io/clux/muslrust:1.95.0-stable@sha256:15a72a4abf1c593b0bea63a4a8f20e95c1e5a0696d7051eca87b9b850b2d7e43
	build     = RUSTUP_TOOLCHAIN=stable CARGO_INCREMENTAL=0 cargo build --release --locked --offline --target x86_64-unknown-linux-musl -p calx-telltale
	deploy    = calx-telltale
	artifact  = target/x86_64-unknown-linux-musl/release/calx-telltale 79062fb1d63827e146996269e68c350ec20d76dccb7fdd9f341d744ddf40ce39

# The census adapter. A separate component rather than a second binary of the
# core, because call/0011 keeps it out of the canonical artifact: the core's
# empty dependency list is what lets its release build offline straight from
# source. Same repository and same pin, since the adapter emits the register
# format the core parses and the two cannot be allowed to drift.
[software "calx-telltale-census"]
	url       = https://github.com/slartibardfast/calx-telltale.git
	pin       = 867917d213ff1d711172e19488619face7dc1da3
	worktrees =
	toolchain = docker.io/clux/muslrust:1.95.0-stable@sha256:15a72a4abf1c593b0bea63a4a8f20e95c1e5a0696d7051eca87b9b850b2d7e43
	build     = RUSTUP_TOOLCHAIN=stable CARGO_INCREMENTAL=0 cargo build --release --locked --offline --target x86_64-unknown-linux-musl -p calx-telltale-census
	deploy    = calx-telltale-census
	artifact  = target/x86_64-unknown-linux-musl/release/calx-telltale-census f04b1fd1ad673c8fc1a696cae8b490dad8339dc2c3692de1c353a2bdd124a65a

# The gating tool, carried as a component rather than a tools/ submodule so that
# one source serves both its skill and its binary (call/0001). Recorded here so
# --install-hooks builds the verified binary and installs the commit hooks.
# Pinned to the revision the adopted template references. Its own .allium is
# discharged by the host-lint repo's CI, not re-wired here.
[software "host-lint"]
	url       = https://github.com/connollydavid/host-lint.git
	pin       = cc3ec6a341b9c13c3a05365bb6e24c938a6d89e3
	worktrees =
	toolchain = docker.io/clux/muslrust:1.95.0-stable@sha256:15a72a4abf1c593b0bea63a4a8f20e95c1e5a0696d7051eca87b9b850b2d7e43
	build     = RUSTUP_TOOLCHAIN=stable CARGO_INCREMENTAL=0 cargo build --release --locked --offline --target x86_64-unknown-linux-musl
	deploy    = host-lint
	artifact  = target/x86_64-unknown-linux-musl/release/host-lint 3e9f048b00291d6a5504541f5a4a3d2fbf6e55293c023ce715e945bb35510056
	deps-bundle = https://github.com/connollydavid/host-lint/releases/download/vendor-v4/vendor.tar.gz 6a463a09d45f057486f8f285d5a86b86999c9be16a714dc51f8b2a8d5e3491f2
	hooks     = pre-commit

# The verification ladder's drivers for this project. A doc that names the
# verifiers must name this whole set.
[verification]
	drivers = host-lint allium specula
